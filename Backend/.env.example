# Default (no .env needed): Windows integrated authentication (SSO) via
# backend\native-auth\mssql-jdbc_auth-12.8.1.x64.dll (added to java.library.path by pom.xml jvmArguments).
#
# Alternative A - NTLM (Java-side Windows auth; needs real Windows credentials, no DLL):
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=xclone;encrypt=true;trustServerCertificate=true;integratedSecurity=true;authenticationScheme=NTLM
# DB_USERNAME=MACHINE\your-windows-user
# DB_PASSWORD=your-windows-password
#
# Alternative B - SQL Server Authentication:
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=xclone;encrypt=true;trustServerCertificate=true
# DB_USERNAME=your-sql-login
# DB_PASSWORD=your-sql-password
JWT_SECRET=replace-with-random-secret-at-least-32-characters